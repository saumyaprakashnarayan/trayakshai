# ==============================================================================
# TrayakshAI Course Backend Environment Variables (Render & Local Development)
# ==============================================================================

# Server Port (Render sets this automatically)
PORT=10000
NODE_ENV=production

# Render Managed PostgreSQL Connection String
# Example: postgresql://username:password@dpg-xxxxx.singapore-postgres.render.com/trayaksh_db?sslmode=require
DATABASE_URL=

# Cryptographic Secrets (Minimum 64 characters random string)
JWT_SECRET=generate_a_random_secure_hex_key_for_jwt_session_encryption_2026

# Administrator Master Credentials (Server-only)
ADMIN_EMAIL=info@trayakshai.com
ADMIN_PASSWORD=SetAStrongRandomAdminPasswordHere2026!

# Razorpay Credentials (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.course.trayakshai.com/api/auth/google/callback

# Allowed Frontend Origins (CORS)
ADDITIONAL_CORS_ORIGIN=https://course.trayakshai.com
